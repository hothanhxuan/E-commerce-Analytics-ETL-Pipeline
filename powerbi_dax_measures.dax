-- =============================================================
-- TechStore Vietnam — Power BI DAX Measures Reference
-- Project: Building an Omnichannel Retail ETL Pipeline
-- =============================================================
-- HOW TO USE:
--   In Power BI Desktop → Modeling tab → New Measure
--   Copy each measure below and paste into the formula bar.
--   Organize measures into a dedicated "Measures" table:
--     Home → Enter Data → name it "_Measures" → Load
--     Then move all measures into this table.
-- =============================================================


-- ─────────────────────────────────────────────────────────────
-- SECTION 0: SHARED / BASE MEASURES (used across all dashboards)
-- ─────────────────────────────────────────────────────────────

Total Revenue VND =
SUM ( fact_orders[total_vnd] )

Total Orders =
COUNTROWS ( fact_orders )

Total Customers =
DISTINCTCOUNT ( dim_customers[customer_id] )


-- ─────────────────────────────────────────────────────────────
-- SECTION 1: DASHBOARD 1 — CUSTOMER JOURNEY
-- Source tables: dim_customers, fact_orders, vw_customer_journey
-- ─────────────────────────────────────────────────────────────
-- ┌─────────────────────────────────────────────────────────────────┐
-- │  TOP ROW SCORE CARDS (5 cards, left → right):                  │
-- │  [1] Total Customers  [2] Active Customers  [3] Avg LTV VND   │
-- │  [4] Avg Orders Per Customer   [5] New Customers               │
-- └─────────────────────────────────────────────────────────────────┘

-- KPI: Total unique customers (excludes Unknown ID=-1 walk-in)
Total Customers =
CALCULATE (
    DISTINCTCOUNT ( dim_customers[customer_id] ),
    dim_customers[customer_id] <> -1
)

-- KPI: Customers who placed at least 1 order
-- FIX: Calculate dynamically from fact_orders to ensure it responds to date 
--      slicers and doesn't out on dim_customers[total_orders] being populated.
Active Customers =
CALCULATE (
    DISTINCTCOUNT ( fact_orders[customer_id] ),
    fact_orders[customer_id] <> -1
)

-- KPI: Average lifetime value per customer (VND)
-- FIX: Calculate dynamically: gets all active customers in current filter context,
--      then averages their ALL-TIME revenue (removing the date filter for the sum).
Avg LTV VND =
CALCULATE (
    AVERAGEX (
        VALUES ( fact_orders[customer_id] ),
        CALCULATE (
            SUM ( fact_orders[total_vnd] ),
            REMOVEFILTERS ( dim_date )
        )
    ),
    fact_orders[customer_id] <> -1
)

-- KPI: Average number of orders per active customer
-- FIX: Calculate dynamically from fact_orders.
Avg Orders Per Customer =
CALCULATE (
    AVERAGEX (
        VALUES ( fact_orders[customer_id] ),
        CALCULATE (
            COUNTROWS ( fact_orders ),
            REMOVEFILTERS ( dim_date )
        )
    ),
    fact_orders[customer_id] <> -1
)

-- Measure: Customer segment count (for donut chart labels)
Segment Customer Count =
CALCULATE (
    DISTINCTCOUNT ( dim_customers[customer_id] ),
    dim_customers[customer_id] <> -1
)

-- Measure: Segment share % of total
Segment Share % =
DIVIDE (
    [Segment Customer Count],
    CALCULATE (
        [Segment Customer Count],
        ALL ( dim_customers[customer_segment] )
    ),
    0
)

-- Measure: New customers acquired within selected period
-- FIX: Calculated from fact_orders so it correctly filters via dim_date relationship.
New Customers = 
VAR CurrentMinDate = MIN ( dim_date[full_date] )
VAR CurrentMaxDate = MAX ( dim_date[full_date] )
RETURN
    CALCULATE (
        DISTINCTCOUNT ( fact_orders[customer_id] ),
        fact_orders[customer_id] <> -1,
        -- Keep only customers whose very first order is within the current period
        FILTER (
            VALUES ( fact_orders[customer_id] ),
            VAR FirstDateForCust = 
                CALCULATE ( 
                    MIN ( fact_orders[order_date] ), 
                    REMOVEFILTERS ( dim_date ) 
                )
            RETURN FirstDateForCust >= CurrentMinDate && FirstDateForCust <= CurrentMaxDate
        )
    )

-- Measure: Cumulative customers over time
-- FIX: Calculated from fact_orders. ALL(dim_date) resets context, then we filter
--      to all dates up to the current point on the X-axis. Also prevents drawing
--      a flat line into future dates (e.g. 2027) when there is no more data.
Cumulative Customers =
VAR MaxDate = MAX ( dim_date[full_date] )
VAR MaxFactDate = CALCULATE ( MAX ( fact_orders[order_date] ), REMOVEFILTERS () )
RETURN
    IF (
        MIN ( dim_date[full_date] ) > MaxFactDate,
        BLANK (),
        CALCULATE (
            DISTINCTCOUNT ( fact_orders[customer_id] ),
            fact_orders[customer_id] <> -1,
            -- Exclude the 400k orphan records by requiring the ID to exist in dim_customers
            fact_orders[customer_id] IN VALUES ( dim_customers[customer_id] ),
            FILTER (
                ALL ( dim_date ),
                dim_date[full_date] <= MaxDate
            )
        )
    )

-- Measure: Revenue by channel
Revenue By Channel =
CALCULATE (
    SUM ( fact_orders[total_vnd] ),
    NOT ISBLANK ( fact_orders[channel] )
)

-- Measure: Order count by channel
Orders By Channel =
COUNTROWS ( FILTER ( fact_orders, NOT ISBLANK ( fact_orders[channel] ) ) )

