-- ─────────────────────────────────────────────────────────────
-- SECTION 2: DASHBOARD 2 — CASHFLOW
-- Source tables: vw_cashflow_daily, fact_bank_transactions
-- ─────────────────────────────────────────────────────────────
-- ┌──────────────────────────────────────────────────────────────────────────┐
-- │  TOP ROW SCORE CARDS (5 cards, left → right):                           │
-- │  [1] Total Sales Revenue  [2] Total Payments Received  [3] Net Cashflow│
-- │  [4] Revenue MoM Growth %   [5] Payment Success Rate %                  │
-- └──────────────────────────────────────────────────────────────────────────┘

-- KPI: Total sales revenue (excluding cancelled/refunded — filtered in view)
Total Sales Revenue =
SUM ( vw_cashflow_daily[sales_revenue_vnd] )

-- KPI: Total payments actually received (successful only)
Total Payments Received =
SUM ( vw_cashflow_daily[payments_received_vnd] )

-- KPI: Total bank inflows
Total Bank Inflow =
SUM ( vw_cashflow_daily[bank_inflow_vnd] )

-- KPI: Total bank outflows
Total Bank Outflow =
SUM ( vw_cashflow_daily[bank_outflow_vnd] )

-- KPI: Net cashflow (sales revenue minus bank outflow, from view)
Net Cashflow =
SUM ( vw_cashflow_daily[net_cashflow_vnd] )

-- KPI: Total order count from cashflow view
Total Order Count =
SUM ( vw_cashflow_daily[order_count] )

-- Measure: Successful payments count
Successful Payments =
SUM ( vw_cashflow_daily[successful_payments] )

-- Measure: Failed payments count
Failed Payments =
SUM ( vw_cashflow_daily[failed_payments] )

-- Measure: Payment success rate %
Payment Success Rate % =
DIVIDE (
    [Successful Payments],
    [Successful Payments] + [Failed Payments],
    0
)

-- Measure: Collection rate (payments received vs revenue booked)
Collection Rate % =
DIVIDE (
    [Total Payments Received],
    [Total Sales Revenue],
    0
)

-- Measure: Revenue Month-over-Month growth %
Revenue MoM Growth % =
VAR CurrentRevenue = [Total Sales Revenue]
VAR PreviousRevenue =
    CALCULATE (
        [Total Sales Revenue],
        DATEADD ( dim_date[full_date], -1, MONTH )
    )
RETURN
    DIVIDE ( CurrentRevenue - PreviousRevenue, PreviousRevenue, BLANK () )

-- Measure: Revenue Year-over-Year growth %
Revenue YoY Growth % =
VAR CurrentRevenue = [Total Sales Revenue]
VAR PreviousRevenue =
    CALCULATE (
        [Total Sales Revenue],
        SAMEPERIODLASTYEAR ( dim_date[full_date] )
    )
RETURN
    DIVIDE ( CurrentRevenue - PreviousRevenue, PreviousRevenue, BLANK () )

-- Measure: Average daily revenue
Avg Daily Revenue =
AVERAGEX (
    VALUES ( vw_cashflow_daily[report_date] ),
    CALCULATE ( SUM ( vw_cashflow_daily[sales_revenue_vnd] ) )
)

-- Measure: Cashflow status label (for conditional card color)
Cashflow Status =
IF ( [Net Cashflow] >= 0, "Positive ▲", "Negative ▼" )


-- ─────────────────────────────────────────────────────────────
-- SECTION 3: DASHBOARD 3 — PAYMENT STATUS
-- Source tables: vw_payment_status, dim_customers
-- ─────────────────────────────────────────────────────────────
-- ┌──────────────────────────────────────────────────────────────────────────┐
-- │  TOP ROW SCORE CARDS (5 cards, left → right):                           │
-- │  [1] PS Total Orders  [2] Paid Orders  [3] Payment Rate %               │
-- │  [4] Total Outstanding VND   [5] Avg Payment Delay Hours                │
-- └──────────────────────────────────────────────────────────────────────────┘

-- KPI: Total orders tracked in payment status view
PS Total Orders =
COUNTROWS ( vw_payment_status )

-- KPI: Paid orders count
Paid Orders =
CALCULATE (
    COUNTROWS ( vw_payment_status ),
    vw_payment_status[payment_status_category] = "Paid"
)

-- KPI: Failed orders count
Failed Orders =
CALCULATE (
    COUNTROWS ( vw_payment_status ),
    vw_payment_status[payment_status_category] = "Failed"
)

-- KPI: Pending orders count
Pending Orders =
CALCULATE (
    COUNTROWS ( vw_payment_status ),
    vw_payment_status[payment_status_category] = "Pending"
)

-- KPI: Overdue orders count
Overdue Orders =
CALCULATE (
    COUNTROWS ( vw_payment_status ),
    vw_payment_status[payment_status_category] = "Overdue"
)

-- KPI: Total outstanding amount (VND) — unpaid orders only
Total Outstanding VND =
CALCULATE (
    SUM ( vw_payment_status[outstanding_amount_vnd] ),
    vw_payment_status[payment_status_category] <> "Paid"
)

-- KPI: Average payment delay for paid orders (hours)
Avg Payment Delay Hours =
CALCULATE (
    AVERAGE ( vw_payment_status[payment_delay_hours] ),
    NOT ISBLANK ( vw_payment_status[payment_delay_hours] )
)

-- Measure: Payment rate % (paid / total orders)
Payment Rate % =
DIVIDE ( [Paid Orders], [PS Total Orders], 0 )

-- Measure: Outstanding amount as % of total order value
Outstanding Rate % =
DIVIDE (
    [Total Outstanding VND],
    SUM ( vw_payment_status[total_vnd] ),
    0
)

-- Measure: Overdue amount (VND)
Overdue Amount VND =
CALCULATE (
    SUM ( vw_payment_status[outstanding_amount_vnd] ),
    vw_payment_status[payment_status_category] = "Overdue"
)

-- Measure: Gateway success rate (for gateway performance chart)
Gateway Success Rate % =
DIVIDE (
    CALCULATE (
        COUNTROWS ( vw_payment_status ),
        vw_payment_status[gateway_payment_status] = "success"
    ),
    COUNTROWS ( vw_payment_status ),
    0
)

-- Measure: Dynamic payment health status label
Payment Health Status =
VAR OverdueCount = [Overdue Orders]
VAR FailedCount  = [Failed Orders]
RETURN
    IF (
        OverdueCount > 0,
        "⚠️ " & OverdueCount & " orders overdue",
        IF ( FailedCount > 0, "❌ " & FailedCount & " failed", "✅ All clear" )
    )

